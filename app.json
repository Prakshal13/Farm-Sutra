{
  "expo": {
    "name": "Farm Sutra",
    "slug": "farm-sutra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "css": true
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#122614"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.farm-sutra"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#122614",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Farm Sutra",
      "shortName": "Farm Sutra",
      "description": "AI-powered app for Indian farmers",
      "themeColor": "#1E3F20",
      "backgroundColor": "#1E3F20"
    },
    "plugins": [
      "expo-asset",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow Farm Sutra to access the microphone to listen to your farming queries.",
          "speechRecognitionPermission": "Allow Farm Sutra to securely recognize your speech."
        }
      ]
    ]
  }
}
